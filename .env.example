# 抖音快代理 TPS 隧道代理（默认关闭）
SAU_API_DOUYIN_PROXY_ENABLED=false

# 开启后，抖音 Cookie 校验最终失败时保存诊断截图（文件权限 0600）。
SAU_API_DEBUG=false

# API 提取鉴权：KDL_SECRET_KEY 非空时使用 HMAC-SHA1，否则使用 KDL_SIGNATURE token。
KDL_SECRET_ID=
KDL_SIGNATURE=
KDL_SECRET_KEY=

# TPS 隧道访问鉴权（与上面的 API 提取鉴权/白名单不是同一项）
# basic: 浏览器使用用户名密码；whitelist: 服务器公网 IP 已加入 TPS 订单的代理白名单。
KDL_PROXY_AUTH_MODE=basic
KDL_USER_NAME=
KDL_USER_PWD=
